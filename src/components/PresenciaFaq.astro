---
import FaqLista from "./FaqLista.astro";

interface Faq {
  question: string;
  questionKey: string;
  answer: string;
  answerKey: string;
}

interface Props {
  faqs: Faq[];
}

const { faqs } = Astro.props;
---

<section id="faq-b2b" class="gs-reveal border-b border-white/10 bg-charcoal px-6 pt-24 md:px-12 md:pt-36" aria-labelledby="faq-b2b-heading">
  <div class="mx-auto max-w-[900px]">
    <span class="text-xs tracking-[0.14em] text-pink uppercase" data-i18n="presenciaFaq.eyebrow">Antes de hablar</span>
    <h2 id="faq-b2b-heading" class="mt-4 h2-fluid" data-i18n="presenciaFaq.heading">Preguntas frecuentes.</h2>
  </div>
</section>
<FaqLista faqs={faqs} />
