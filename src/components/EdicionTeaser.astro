---
import { getActiveEdition } from "../lib/edition";

const EDITION = await getActiveEdition();
const esCena = EDITION?.formato === "cena";
---

{
  EDITION && (
    <section id="edicion" class="gs-reveal border-t border-white/10 bg-gradient-to-br from-charcoal-2 to-black px-6 py-28 md:px-12 md:py-40">
      <div class="mx-auto max-w-[1440px]">
        <div class="flex flex-col gap-2 text-xs tracking-[0.14em] text-white/50 uppercase md:flex-row md:items-center md:justify-between">
          <span class="text-pink" data-i18n={esCena ? "edicionTeaser.labelCena" : "edicionTeaser.label"}>
            {esCena ? "Cena temática · Plazas limitadas" : "Edición especial · Activa ahora"}
          </span>
          <span data-i18n={EDITION.plazoLabelKey}>{EDITION.plazoLabel}</span>
        </div>
        <h2 class="mt-6 font-display text-[clamp(2.8rem,7vw,8rem)] leading-[0.98] tracking-[-0.01em]">{EDITION.nombre}</h2>
        <p class="mt-6 max-w-[58ch] text-lg text-white/70" data-i18n={EDITION.descripcionKey}>
          {EDITION.descripcion}
        </p>
        <a
          href="/ediciones-especiales/"
          data-i18n={esCena ? "edicionTeaser.ctaCena" : "edicionTeaser.cta"}
          class="mt-8 inline-block rounded-full border border-pink px-6 py-3 text-xs tracking-[0.1em] text-pink uppercase transition-colors hover:bg-pink hover:text-black"
        >
          {esCena ? "Reserva tu plaza" : "Ver la edición"}
        </a>
      </div>
    </section>
  )
}
