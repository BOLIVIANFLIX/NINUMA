---
import type { EdicionActiva } from "../lib/edition";

interface Props {
  edition: EdicionActiva;
}
const { edition: EDITION } = Astro.props;
---

<section class="gs-reveal border-t border-white/10 bg-black px-6 py-24 md:px-12 md:py-36" aria-labelledby="menu-heading">
  <div class="mx-auto max-w-[1440px]">
    <div class="mb-16">
      <span class="text-xs tracking-[0.14em] text-pink uppercase" data-i18n="ediciones.menuEyebrow">El menú</span>
      <h2 id="menu-heading" class="mt-4 h2-fluid" data-i18n="ediciones.menuHeading">Siete pases.<br />Y un secreto final.</h2>
    </div>
    <ol class="gs-stagger flex flex-col divide-y divide-white/10 border-t border-b border-white/10">
      {
        EDITION.menu.map((plato) => (
          <li class="gs-item flex flex-col gap-1 py-6 md:flex-row md:items-baseline md:gap-8">
            <span class="w-32 shrink-0 text-xs tracking-[0.14em] text-pink uppercase" data-i18n={plato.cursoKey}>
              {plato.curso}
            </span>
            <span class="font-display text-2xl leading-tight" data-i18n={plato.nombreKey}>
              {plato.nombre}
            </span>
            <span class="text-sm text-white/50 italic" data-i18n={plato.descriptorKey}>
              {plato.descriptor}
            </span>
          </li>
        ))
      }
    </ol>
  </div>
</section>
